{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "retail-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true,
          "inlineStyle": false,
          "inlineTemplate": false,
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "/assets/"
              }
            ],
            "styles": [
              "node_modules/@fontsource/material-icons/index.css",
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1.2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "baseHref": "./",
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "grocery": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1.2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "baseHref": "./",
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json",
              "fileReplacements": [
                {
                  "replace": "src/app/core/store-profile/active-store-profile.ts",
                  "with": "src/app/core/store-profile/active-store-profile.grocery.ts"
                }
              ]
            },
            "client-tobacco": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1.2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "baseHref": "./",
              "outputHashing": "all"
            },
            "client-grocery": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1.2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "baseHref": "./",
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/app/core/store-profile/active-store-profile.ts",
                  "with": "src/app/core/store-profile/active-store-profile.grocery.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "retail-app:build:production"
            },
            "development": {
              "buildTarget": "retail-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "retail-kernel": {
      "projectType": "library",
      "root": "projects/retail-kernel",
      "sourceRoot": "projects/retail-kernel/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/retail-kernel/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/retail-kernel/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/retail-kernel/tsconfig.spec.json"
          }
        }
      }
    },
    "store-profiles": {
      "projectType": "library",
      "root": "projects/store-profiles",
      "sourceRoot": "projects/store-profiles/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/store-profiles/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/store-profiles/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/store-profiles/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
