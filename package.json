{
  "name": "retail-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve retail-app",
    "build": "ng build",
    "build:production": "ng build --configuration=production",
    "build:kernel": "ng build retail-kernel --configuration=production",
    "build:profiles": "ng build store-profiles --configuration=production",
    "watch": "ng build --watch --configuration=development",
    "lint": "ng lint retail-app && ng lint retail-kernel && ng lint store-profiles",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@angular/animations": "22.0.8",
    "@angular/cdk": "22.0.6",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/material": "22.0.6",
    "@angular/platform-browser": "22.0.8",
    "@angular/router": "22.0.8",
    "@angular/service-worker": "22.0.8",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "decimal.js": "10.6.0",
    "dexie": "4.4.4",
    "dexie-export-import": "4.4.0",
    "exceljs": "4.4.0",
    "file-saver": "2.0.5",
